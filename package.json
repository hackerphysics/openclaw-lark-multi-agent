{
  "name": "openclaw-lark-multi-agent",
  "version": "1.8.17",
  "description": "Multi-bot Lark/Feishu bridge for OpenClaw, with per-bot model routing and isolated sessions",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:steer-plugin && npm run build:go-plugin && npm run build:core-plugin",
    "build:steer-plugin": "tsc -p plugins/lma-steer/tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run --config tests/normal-flow-offline.config.ts",
    "test:coverage": "vitest run --config tests/normal-flow-offline.config.ts --coverage",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm pack --dry-run",
    "build:go-plugin": "tsc -p plugins/lma-go/tsconfig.json",
    "build:core-plugin": "tsc -p plugins/lma-core/tsconfig.json",
    "test:sdk-contract": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck tests/reliability-public-sdk.test.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.3",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.9.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "openclaw": "^2026.8.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hackerphysics/openclaw-lark-multi-agent.git"
  },
  "bugs": {
    "url": "https://github.com/hackerphysics/openclaw-lark-multi-agent/issues"
  },
  "homepage": "https://github.com/hackerphysics/openclaw-lark-multi-agent#readme",
  "keywords": [
    "openclaw",
    "lark",
    "feishu",
    "multi-agent",
    "chatbot",
    "agent",
    "gateway"
  ],
  "bin": {
    "lma": "dist/cli.js",
    "openclaw-lark-multi-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "plugins/lma-steer/dist",
    "plugins/lma-steer/openclaw.plugin.json",
    "plugins/lma-steer/package.json",
    "plugins/lma-steer/README.md",
    "plugins/lma-go/dist",
    "plugins/lma-go/openclaw.plugin.json",
    "plugins/lma-go/package.json",
    "plugins/lma-go/README.md",
    "config.example.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md",
    "plugins/lma-core/dist",
    "plugins/lma-core/openclaw.plugin.json",
    "plugins/lma-core/package.json",
    "plugins/lma-core/README.md",
    "docs/releases/1.8.5.md",
    "docs/releases/1.8.10.md",
    "docs/releases/1.8.11.md",
    "docs/releases/1.8.15.md",
    "docs/releases/1.8.16.md",
    "docs/releases/1.8.17.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
